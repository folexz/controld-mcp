# Control D API tokens (create at https://controld.com/dashboard/api)
# READ token is required — the server refuses to start without it.
CONTROLD_API_TOKEN_READ=api.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WRITE token is optional. If omitted, all mutating tools (POST/PUT/PATCH/DELETE)
# are NOT registered — the server becomes physically read-only.
CONTROLD_API_TOKEN_WRITE=api.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# CONTROLD_API_BASE_URL=https://api.controld.com
# CONTROLD_ORG_ID=org_id_here   # sent as X-Force-Org-Id (organization accounts only)
