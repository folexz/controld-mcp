{
  "name": "controld-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Control D API — spec-driven tools, two-token least-privilege auth",
  "type": "module",
  "license": "MIT",
  "author": "folexz",
  "homepage": "https://github.com/folexz/controld-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/folexz/controld-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/folexz/controld-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "controld",
    "control-d",
    "dns",
    "claude"
  ],
  "bin": {
    "controld-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "spec/controld-openapi.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build-spec": "tsx scripts/build-spec.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
